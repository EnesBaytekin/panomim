# Todoer ortam değişkenleri
# Bu dosyayı ".env" olarak kopyalayın:  cp .env.example .env
# docker compose .env dosyasını otomatik okur; systemd'de EnvironmentFile= ile verilir.

# Dinleme adresi (host:port)
TODOER_ADDR=:8443

# Docker imajı (build.sh ile farklı ad/etiket derlediyseniz buraya yazın)
# TODOER_IMAGE=todoer:latest

# Düz HTTP: ters proxy (Caddy/nginx) arkasında true bırakın.
# Doğrudan erişimde false yapın → konteyner otomatik TLS kullanır.
TODOER_HTTP=true

# Doğrudan erişimde Let's Encrypt ile otomatik sertifika için alan adınız:
# (TODOER_HTTP=false olmalı ve 80/443 portları açık olmalı)
# TODOER_HTTPS_DOMAIN=todo.example.com

# Kendi sertifikanız varsa ikisini birden verin (PEM):
# TODOER_CERT=/certs/fullchain.pem
# TODOER_KEY=/certs/privkey.pem

# Veri dizini (compose içinde /data olarak sabittir; ikili dosya kurulumunda
# varsayılanı ~/.local/share/todoer — isterseniz değiştirin)
# TODOER_DATA=/var/lib/todoer

# Oturum ömürleri (Go süre biçimi: 15m, 12h, 360h)
# TODOER_ACCESS_TTL=15m
# TODOER_REFRESH_TTL=360h

# Geliştirme: frontend'i diskten sunar (yalnızca kaynak koddan çalıştırırken)
# TODOER_DEV=false
